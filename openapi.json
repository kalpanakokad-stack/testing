{
  "openapi": "3",
  "info": {
    "title": "Acme Commerce API",
    "version": "2.0.0",
    "description": "Updated API for OpenAPI compatibility analysis."
  },
  "servers": [
    {
      "url": "https://api.example.com/v2"
    },
    {
      "url": "https://staging-api.example.com/v2"
    }
  ],
  "tags": [
    { "name": "Users" },
    { "name": "Products" },
    { "name": "Orders" },
    { "name": "Payments" },
    { "name": "Reports" },
    { "name": "Admin" },
    { "name": "Analytics" }
  ],
  "paths": {
    "/users": {
      "get": {
        "tags": ["Users"],
        "operationId": "listUsers",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["active", "inactive", "suspended"]
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["createdAt", "name", "email", "updatedAt"]
            }
          },
          {
            "name": "includeDeleted",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Users returned",
            "headers": {
              "X-Total-Count": {
                "schema": {
                  "type": "integer"
                }
              },
              "X-Next-Page": {
                "schema": {
                  "type": ["integer", "null"]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["items", "page", "limit", "total"],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/User"
                      }
                    },
                    "page": {
                      "type": "integer"
                    },
                    "limit": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer"
                    },
                    "nextPage": {
                      "type": ["integer", "null"]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      },

      "post": {
        "tags": ["Users"],
        "operationId": "createUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },

    "/users/{userId}": {
      "get": {
        "tags": ["Users"],
        "operationId": "getUser",
        "parameters": [
          {
            "$ref": "#/components/parameters/UserId"
          }
        ],
        "responses": {
          "200": {
            "description": "User",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "410": {
            "description": "User permanently deleted"
          }
        }
      },

      "put": {
        "tags": ["Users"],
        "operationId": "replaceUser",
        "parameters": [
          {
            "$ref": "#/components/parameters/UserId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },

      "delete": {
        "tags": ["Users"],
        "operationId": "deleteUser",
        "parameters": [
          {
            "$ref": "#/components/parameters/UserId"
          }
        ],
        "responses": {
          "200": {
            "description": "User deleted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },

    "/products": {
      "get": {
        "tags": ["Products"],
        "operationId": "listProducts",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 2
            }
          },
          {
            "name": "minPrice",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "minimum": 1
            }
          },
          {
            "name": "maxPrice",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "minimum": 1
            }
          },
          {
            "name": "available",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "currency",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["USD", "EUR", "GBP", "INR", "JPY"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Products",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Product"
                  }
                }
              }
            }
          },
          "206": {
            "description": "Partial product result"
          }
        }
      },

      "post": {
        "tags": ["Products"],
        "operationId": "createProduct",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProductRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Product created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },

    "/products/{productId}": {
      "get": {
        "tags": ["Products"],
        "operationId": "getProduct",
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^product_[a-zA-Z0-9]+$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Product",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },

      "patch": {
        "tags": ["Products"],
        "operationId": "patchProduct",
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchProductRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Product updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          }
        }
      }
    },

    "/orders": {
      "get": {
        "tags": ["Orders"],
        "operationId": "listOrders",
        "parameters": [
          {
            "name": "customerId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "confirmed",
                "shipped",
                "delivered",
                "cancelled",
                "refunded"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Orders",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Order"
                  }
                }
              }
            }
          }
        }
      },

      "post": {
        "tags": ["Orders"],
        "operationId": "createOrder",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },

    "/orders/{orderId}": {
      "get": {
        "tags": ["Orders"],
        "operationId": "getOrder",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },

      "patch": {
        "tags": ["Orders"],
        "operationId": "updateOrder",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateOrderRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          }
        }
      }
    },

    "/payments": {
      "post": {
        "tags": ["Payments"],
        "operationId": "createPayment",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePaymentRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Payment created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          },
          "402": {
            "description": "Payment required"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },

    "/reports/sales": {
      "get": {
        "tags": ["Reports"],
        "operationId": "getSalesReport",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "groupBy",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["day", "week", "month"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sales report",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SalesReport"
                }
              }
            }
          }
        }
      }
    },

    "/admin/users/{userId}/suspend": {
      "post": {
        "tags": ["Admin"],
        "operationId": "suspendUser",
        "parameters": [
          {
            "$ref": "#/components/parameters/UserId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["reason"],
                "properties": {
                  "reason": {
                    "type": "string",
                    "minLength": 5
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User suspended"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },

    "/analytics/summary": {
      "get": {
        "tags": ["Analytics"],
        "operationId": "getAnalyticsSummary",
        "responses": {
          "200": {
            "description": "Analytics summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyticsSummary"
                }
              }
            }
          }
        }
      }
    }
  },

  "components": {
    "parameters": {
      "UserId": {
        "name": "userId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^user_[a-zA-Z0-9]+$"
        }
      }
    },

    "schemas": {
      "Address": {
        "type": "object",
        "required": [
          "street",
          "city",
          "country",
          "postalCode"
        ],
        "properties": {
          "street": {
            "type": "string",
            "minLength": 3,
            "maxLength": 150
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "postalCode": {
            "type": "string",
            "minLength": 5
          },
          "country": {
            "type": "string",
            "minLength": 2,
            "maxLength": 3
          },
          "district": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": false
      },

      "User": {
        "type": "object",
        "required": [
          "id",
          "email",
          "name",
          "status",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^user_[a-zA-Z0-9]+$"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 150
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "phone": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive",
              "suspended"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "admin",
              "manager"
            ]
          },
          "address": {
            "$ref": "#/components/schemas/Address"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string"
              },
              "campaign": {
                "type": "string"
              }
            }
          }
        },
        "additionalProperties": false
      },

      "CreateUserRequest": {
        "type": "object",
        "required": [
          "email",
          "name",
          "password",
          "phone"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "password": {
            "type": "string",
            "minLength": 12
          },
          "phone": {
            "type": "string",
            "pattern": "^\\+[1-9][0-9]{7,14}$"
          },
          "role": {
            "type": "string",
            "enum": ["user", "admin", "manager"],
            "default": "user"
          },
          "address": {
            "$ref": "#/components/schemas/Address"
          }
        },
        "additionalProperties": false
      },

      "UpdateUserRequest": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "phone": {
            "type": "string"
          },
          "address": {
            "$ref": "#/components/schemas/Address"
          }
        },
        "additionalProperties": false
      },

      "Money": {
        "type": "object",
        "required": ["amount", "currency"],
        "properties": {
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0,
            "multipleOf": 0.01
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "EUR",
              "GBP",
              "INR",
              "JPY"
            ]
          }
        },
        "additionalProperties": false
      },

      "Product": {
        "type": "object",
        "required": [
          "id",
          "name",
          "price",
          "category",
          "stock",
          "createdAt",
          "sku"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^product_[a-zA-Z0-9]+$"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "description": {
            "type": "string"
          },
          "price": {
            "$ref": "#/components/schemas/Money"
          },
          "category": {
            "type": "string",
            "minLength": 2
          },
          "stock": {
            "type": "integer",
            "minimum": 1
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "active": {
            "type": "boolean"
          },
          "sku": {
            "type": "string",
            "pattern": "^SKU-[A-Z0-9-]+$"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },

      "CreateProductRequest": {
        "type": "object",
        "required": [
          "name",
          "price",
          "category",
          "sku"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2
          },
          "description": {
            "type": "string"
          },
          "price": {
            "$ref": "#/components/schemas/Money"
          },
          "category": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sku": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },

      "PatchProductRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": ["string", "null"]
          },
          "price": {
            "$ref": "#/components/schemas/Money"
          },
          "active": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },

      "OrderItem": {
        "type": "object",
        "required": [
          "productId",
          "quantity",
          "unitPrice"
        ],
        "properties": {
          "productId": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "unitPrice": {
            "$ref": "#/components/schemas/Money"
          },
          "discount": {
            "$ref": "#/components/schemas/Money"
          }
        },
        "additionalProperties": false
      },

      "Order": {
        "type": "object",
        "required": [
          "id",
          "customerId",
          "items",
          "status",
          "total",
          "createdAt",
          "currency"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^order_[a-zA-Z0-9]+$"
          },
          "customerId": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "confirmed",
              "shipped",
              "delivered",
              "cancelled",
              "refunded"
            ]
          },
          "total": {
            "$ref": "#/components/schemas/Money"
          },
          "shippingAddress": {
            "$ref": "#/components/schemas/Address"
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "EUR",
              "GBP",
              "INR",
              "JPY"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },

      "CreateOrderRequest": {
        "type": "object",
        "required": [
          "customerId",
          "items",
          "shippingAddress",
          "paymentMethod"
        ],
        "properties": {
          "customerId": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            }
          },
          "shippingAddress": {
            "$ref": "#/components/schemas/Address"
          },
          "couponCode": {
            "type": "string"
          },
          "paymentMethod": {
            "type": "string",
            "enum": [
              "card",
              "bank_transfer",
              "wallet",
              "cash"
            ]
          }
        },
        "additionalProperties": false
      },

      "UpdateOrderRequest": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "shipped",
              "delivered",
              "cancelled",
              "refunded"
            ]
          },
          "shippingAddress": {
            "$ref": "#/components/schemas/Address"
          }
        },
        "additionalProperties": false
      },

      "CreatePaymentRequest": {
        "type": "object",
        "required": [
          "orderId",
          "amount",
          "method",
          "idempotencyKey"
        ],
        "properties": {
          "orderId": {
            "type": "string"
          },
          "amount": {
            "$ref": "#/components/schemas/Money"
          },
          "method": {
            "type": "string",
            "enum": [
              "card",
              "bank_transfer",
              "wallet"
            ]
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 16,
            "maxLength": 64
          }
        },
        "additionalProperties": false
      },

      "Payment": {
        "type": "object",
        "required": [
          "id",
          "orderId",
          "amount",
          "method",
          "status",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "orderId": {
            "type": "string"
          },
          "amount": {
            "$ref": "#/components/schemas/Money"
          },
          "method": {
            "type": "string",
            "enum": [
              "card",
              "bank_transfer",
              "wallet"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "authorized",
              "failed",
              "refunded",
              "partially_refunded"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },

      "SalesReport": {
        "type": "object",
        "required": [
          "from",
          "to",
          "totalOrders",
          "totalRevenue",
          "averageOrderValue"
        ],
        "properties": {
          "from": {
            "type": "string",
            "format": "date"
          },
          "to": {
            "type": "string",
            "format": "date"
          },
          "totalOrders": {
            "type": "integer",
            "minimum": 0
          },
          "totalRevenue": {
            "$ref": "#/components/schemas/Money"
          },
          "averageOrderValue": {
            "$ref": "#/components/schemas/Money"
          }
        },
        "additionalProperties": false
      },

      "DeleteResponse": {
        "type": "object",
        "required": ["deleted", "id"],
        "properties": {
          "deleted": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },

      "AnalyticsSummary": {
        "type": "object",
        "required": [
          "totalUsers",
          "totalProducts",
          "totalOrders",
          "revenue"
        ],
        "properties": {
          "totalUsers": {
            "type": "integer"
          },
          "totalProducts": {
            "type": "integer"
          },
          "totalOrders": {
            "type": "integer"
          },
          "revenue": {
            "$ref": "#/components/schemas/Money"
          }
        },
        "additionalProperties": false
      },

      "Error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "timestamp"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": false
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },

    "responses": {
      "BadRequest": {
        "description": "Bad request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },

      "Unauthorized": {
        "description": "Authentication required",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },

      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },

      "Conflict": {
        "description": "Conflict",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },

      "ValidationError": {
        "description": "Validation error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },

    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
